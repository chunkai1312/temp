      "expected_reference_ids": ["KB-F19-001"],
      "expected_facts": ["不是", "代碼 05", "本年累積交易總額"]
    },
    {
      "id": "f19-fields-03",
      "group": "f19-fields",
      "question": "表十九的放款、捐贈和保證背書各填什麼金額？",
      "expected_reference_ids": ["KB-F19-001"],
      "expected_facts": ["放款填當月最高餘額", "捐贈填本年累積交易總額", "保證及背書填當月最高餘額"]
