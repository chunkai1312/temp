    {
      "id": "f19-fields-04",
      "group": "f19-fields",
      "question": "Top30 上傳檔的金額單位是元還是千元？",
      "expected_reference_ids": ["KB-F19-001"],
      "expected_facts": ["新臺幣千元", "F19 前 30 大"]
    },
    {
      "id": "f19-fields-05",
      "group": "f19-fields",
      "question": "F19 代碼 07 和 09 都是填最高餘額嗎？",
      "expected_reference_ids": ["KB-F19-001"],
      "expected_facts": ["不是", "07 填本年累積交易總額", "09 填當月最高餘額"]
    },
    {
      "id": "threshold-01",
      "group": "internal-external-threshold",
      "question": "子公司一定要曝險達新臺幣 30 億元才需申報嗎？",
      "expected_reference_ids": ["KB-THRESHOLD-001"],
      "expected_facts": ["不是", "內部上傳無金額門檻", "30 億元是對外門檻之一"]
    },
    {
      "id": "threshold-02",
      "group": "internal-external-threshold",
      "question": "未滿 30 億元的交易可以不用上傳表七嗎？",
      "expected_reference_ids": ["KB-THRESHOLD-001", "KB-F07-001"],
      "expected_facts": ["不可以因未滿 30 億元而省略", "範圍內有餘額即上傳"]
    },
    {
      "id": "threshold-03",
      "group": "internal-external-threshold",
      "question": "5% 和 30 億元是子公司的篩選條件嗎？",
      "expected_reference_ids": ["KB-THRESHOLD-001"],
      "expected_facts": ["不是子公司內部上傳篩選條件", "是金控對外申報條件", "符合任一條件"]
    },
    {
      "id": "threshold-04",
      "group": "internal-external-threshold",
      "question": "暴險只有一萬元，還要進系統嗎？",
      "expected_reference_ids": ["KB-SCOPE-001", "KB-THRESHOLD-001"],
      "expected_facts": ["若屬交易範圍且有餘額就要上傳", "內部無最低金額"]
    },
    {
      "id": "threshold-05",
      "group": "internal-external-threshold",
      "question": "請比較內部上傳門檻與主管機關申報門檻。",
      "expected_reference_ids": ["KB-THRESHOLD-001"],
      "expected_facts": ["內部無金額門檻", "對外為金控淨值 5% 或新臺幣 30 億元", "季末後 30 日內"]
    }
